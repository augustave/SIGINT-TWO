{
  "version": "1.0.0",
  "description": "SIGINT Terrain palette tokens. Single source of truth for SVG patterns, shaders, and downstream renderers. Doctrine-allowed palettes only.",
  "palettes": {
    "tactical_hypso": {
      "description": "First-5-only hypsometric bands for low-relief terrain. Used by nyc_littoral_low_relief profile.",
      "bands": [
        {"name": "band_0_2m",   "fill": "#1f3a4d", "label": "0-2 m"},
        {"name": "band_2_5m",   "fill": "#2c5468", "label": "2-5 m"},
        {"name": "band_5_10m",  "fill": "#4a7388", "label": "5-10 m"},
        {"name": "band_10_20m", "fill": "#7a9aa8", "label": "10-20 m"},
        {"name": "band_20_50m", "fill": "#b5c8d2", "label": "20-50 m"}
      ]
    },
    "slope_severity": {
      "description": "Hachure stroke colors per slope band (degrees).",
      "bands": [
        {"name": "slope_0_5",   "stroke": "#9aa3a8", "spacing_px": 0,  "stroke_width_px": 0,   "label": "0-5\u00b0",  "render": "none"},
        {"name": "slope_5_15",  "stroke": "#6e7b80", "spacing_px": 8,  "stroke_width_px": 0.6, "label": "5-15\u00b0"},
        {"name": "slope_15_30", "stroke": "#3f4a4f", "spacing_px": 4,  "stroke_width_px": 0.9, "label": "15-30\u00b0"},
        {"name": "slope_30_45", "stroke": "#2a3236", "spacing_px": 2,  "stroke_width_px": 1.1, "label": "30-45\u00b0"},
        {"name": "slope_45_up", "stroke": "#15191c", "spacing_px": 1,  "stroke_width_px": 1.4, "label": "45\u00b0+"}
      ]
    },
    "denied_red_family": {
      "description": "Crosshatch overlay for denied/contested/blackout zones. High contrast, never feathered.",
      "stroke": "#b1241c",
      "fill_tint": "#b1241c",
      "fill_tint_alpha": 0.12,
      "spacing_px": 6,
      "stroke_width_px": 1.2,
      "angle_deg": 45
    },
    "uncertainty_wash_orange_red_family": {
      "description": "Wash overlay applied by feed age tier. CURRENT shows nothing; tier intensity scales with age.",
      "tiers": [
        {"name": "CURRENT",    "fill": "#000000", "alpha": 0.00, "label": "< 30 min"},
        {"name": "RECENT",     "fill": "#f4a261", "alpha": 0.12, "label": "30 min - 2 h"},
        {"name": "AGING",      "fill": "#e76f51", "alpha": 0.22, "label": "2 - 6 h"},
        {"name": "STALE",      "fill": "#c1432f", "alpha": 0.34, "label": "6 - 24 h"},
        {"name": "HISTORICAL", "fill": "#7a1f15", "alpha": 0.46, "label": "> 24 h"}
      ]
    },
    "confidence_stipple": {
      "description": "Stipple grain density per provenance class. Higher density = lower confidence.",
      "fill": "#1c1c1c",
      "classes": [
        {"name": "high_res_lidar",    "dot_radius_px": 0.4, "spacing_px": 14, "label": "High-res LiDAR"},
        {"name": "medium_confidence", "dot_radius_px": 0.6, "spacing_px": 9,  "label": "Medium confidence"},
        {"name": "interpolated",      "dot_radius_px": 0.9, "spacing_px": 6,  "label": "Interpolated"},
        {"name": "synthetic",         "dot_radius_px": 1.2, "spacing_px": 4,  "label": "Synthetic"}
      ]
    },
    "scan_line_overlay": {
      "description": "Live-feed scan lines. Applied only to active ingest surfaces; 4% opacity.",
      "stroke": "#9bd1ff",
      "stroke_width_px": 1,
      "spacing_px": 4,
      "alpha": 0.04
    },
    "hillshade": {
      "description": "Hillshade substrate is computed per pixel from DEM, not a static color. Reference values for sample swatches only.",
      "shadow": "#2a2a2a",
      "highlight": "#e8e8e8",
      "default_opacity_range": [0.55, 0.65],
      "default_azimuth_deg": 315,
      "default_altitude_deg": 45
    }
  },
  "disallow_palettes": [
    "rainbow_hypsometric",
    "decorative_denied_zone",
    "freshness_tints_outside_defined_buckets"
  ]
}
