{
  "version": "1.1.0",
  "description": "SIGINT Terrain palette tokens. Single source of truth for SVG patterns, shaders, and downstream renderers. Doctrine-allowed palettes only.",
  "substrate": {
    "tactical_dark_bg": "#0d1014",
    "tactical_dark_panel": "#11151a",
    "tactical_grid_line": "#1c2228",
    "tactical_text_primary": "#e6e9ec",
    "tactical_text_secondary": "#8a939b",
    "tactical_accent_green": "#76d36a",
    "tactical_accent_blue": "#9bd1ff"
  },
  "palettes": {
    "tactical_hypso": {
      "description": "Continuous tactical hypsometric ramp. Negative through high-altitude. The first 5 above-zero bands form the low-relief subset used by nyc_littoral_low_relief. Rainbow ramps are forbidden.",
      "bands": [
        {"name": "band_neg_50m", "fill": "#0a1f33", "label": "-50m",  "elev_m": -50,  "subset": "bathymetric"},
        {"name": "band_0m",      "fill": "#1f3a4d", "label": "0",     "elev_m": 0,    "subset": "low_relief"},
        {"name": "band_10m",     "fill": "#2c4a3a", "label": "10",    "elev_m": 10,   "subset": "low_relief"},
        {"name": "band_50m",     "fill": "#3d5a3a", "label": "50",    "elev_m": 50,   "subset": "low_relief"},
        {"name": "band_100m",    "fill": "#5d6a3a", "label": "100",   "elev_m": 100,  "subset": "low_relief"},
        {"name": "band_250m",    "fill": "#7a6a3a", "label": "250",   "elev_m": 250,  "subset": "low_relief"},
        {"name": "band_500m",    "fill": "#8a5a3a", "label": "500",   "elev_m": 500,  "subset": "regional"},
        {"name": "band_1km",     "fill": "#7a3a2a", "label": "1km",   "elev_m": 1000, "subset": "regional"},
        {"name": "band_2km",     "fill": "#5a2a22", "label": "2km",   "elev_m": 2000, "subset": "alpine"},
        {"name": "band_4km_up",  "fill": "#e8e8e8", "label": "4km+",  "elev_m": 4000, "subset": "alpine"}
      ]
    },
    "slope_severity": {
      "description": "Hachure stroke colors and mobility classification per slope band (degrees). Six bands; mobility label is doctrine, not decoration.",
      "bands": [
        {"name": "slope_0_3",   "stroke": "#9aa3a8", "spacing_px": 0,  "stroke_width_px": 0,   "label": "0-3\u00b0",   "mobility": "all vehicles", "fill": "#3a5a3a", "render": "none"},
        {"name": "slope_3_10",  "stroke": "#9aa3a8", "spacing_px": 10, "stroke_width_px": 0.5, "label": "3-10\u00b0",  "mobility": "wheeled",      "fill": "#4a6a3a"},
        {"name": "slope_10_20", "stroke": "#7a8388", "spacing_px": 7,  "stroke_width_px": 0.7, "label": "10-20\u00b0", "mobility": "tracked",      "fill": "#7a6a3a"},
        {"name": "slope_20_30", "stroke": "#5a6368", "spacing_px": 5,  "stroke_width_px": 0.9, "label": "20-30\u00b0", "mobility": "dismount",     "fill": "#8a5a3a"},
        {"name": "slope_30_45", "stroke": "#3f4a4f", "spacing_px": 3,  "stroke_width_px": 1.0, "label": "30-45\u00b0", "mobility": "technical",    "fill": "#7a3a2a"},
        {"name": "slope_45_up", "stroke": "#15191c", "spacing_px": 1,  "stroke_width_px": 1.4, "label": "45-90\u00b0", "mobility": "cliff",        "fill": "#5a2a22"}
      ]
    },
    "denied_red_family": {
      "description": "Crosshatch overlay for denied/contested/blackout zones. High contrast, never feathered.",
      "stroke": "#d63a30",
      "fill_tint": "#b1241c",
      "fill_tint_alpha": 0.14,
      "spacing_px": 6,
      "stroke_width_px": 1.2,
      "angle_deg": 45
    },
    "uncertainty_wash_orange_red_family": {
      "description": "Wash overlay applied by feed age tier, with internal texture motif. CURRENT shows nothing; tier intensity scales with age.",
      "tiers": [
        {"name": "CURRENT",    "fill": "#1f3a2f", "alpha": 0.65, "label": "<30m",     "motif": "grid"},
        {"name": "RECENT",     "fill": "#3a4a2c", "alpha": 0.70, "label": "30m-2h",   "motif": "wave_low"},
        {"name": "AGING",      "fill": "#5a4a22", "alpha": 0.78, "label": "2-6h",     "motif": "wave_mid"},
        {"name": "STALE",      "fill": "#5a2820", "alpha": 0.82, "label": "6-24h",    "motif": "tick_dense"},
        {"name": "HISTORICAL", "fill": "#3a1410", "alpha": 0.88, "label": ">24h",     "motif": "chevron"}
      ]
    },
    "confidence_stipple": {
      "description": "Stipple grain density per provenance class. Higher density = lower confidence. Rendered as light grain on the dark tactical substrate.",
      "fill": "#cfd2c7",
      "classes": [
        {"name": "high_res_lidar",    "dot_radius_px": 0.4, "spacing_px": 14, "label": "High-res LiDAR"},
        {"name": "medium_confidence", "dot_radius_px": 0.6, "spacing_px": 9,  "label": "Medium confidence"},
        {"name": "interpolated",      "dot_radius_px": 0.9, "spacing_px": 6,  "label": "Interpolated"},
        {"name": "synthetic",         "dot_radius_px": 1.2, "spacing_px": 4,  "label": "Synthetic"}
      ],
      "shorthand_low_conf": "interpolated",
      "shorthand_high_conf": "high_res_lidar"
    },
    "hillshade_grain": {
      "description": "Subtle low-frequency grain representing the hillshade substrate texture. Reference swatch only; production hillshade is computed per-pixel from the DEM.",
      "fill": "#1a1f24",
      "grain_fill": "#2a3036",
      "grain_density": 0.06
    },
    "contour_hachure": {
      "description": "Reference swatch for the contour-line layer. Curving strokes evoke iso-elevation lines, not a fill pattern.",
      "stroke": "#8a939b",
      "stroke_width_px": 0.7,
      "spacing_px": 12
    },
    "scan_line_overlay": {
      "description": "Live-feed scan lines. Applied only to active ingest surfaces; 4% opacity in production, rendered louder here for legibility.",
      "stroke": "#9bd1ff",
      "stroke_width_px": 1,
      "spacing_px": 4,
      "alpha": 0.04
    },
    "hillshade": {
      "description": "Hillshade substrate is computed per pixel from DEM, not a static color. Reference values for sample swatches only.",
      "shadow": "#2a2a2a",
      "highlight": "#e8e8e8",
      "default_opacity_range": [0.55, 0.65],
      "default_azimuth_deg": 315,
      "default_altitude_deg": 45
    }
  },
  "disallow_palettes": [
    "rainbow_hypsometric",
    "decorative_denied_zone",
    "freshness_tints_outside_defined_buckets"
  ]
}
